# 复制为 termux/build.env 后按本机改；build.env 已在 .gitignore。
# 改编自 android-termux-builders4JMNeXt（MPL-2.0）。

# 项目根目录（Termux 路径）
PROJECT_DIR=/data/data/com.termux/files/home/BEN/Better-Endfield-Next-mod-ForTMR4A

# 构建容器根（chroot / proot rootfs）。留空 = 直接在 Termux 宿主构建。
CHROOT_ROOT=

# 容器内工具路径（CHROOT_ROOT 为空时忽略）
CONTAINER_JDK=/opt/jdk-21
CONTAINER_GRADLE=/opt/gradle/bin/gradle

# Android SDK：宿主模式填 Termux 路径；容器模式填容器内路径
ANDROID_SDK=/data/data/com.termux/files/home/android-sdk
AAPT2_BUILD_TOOLS=35.0.0

# Gradle 任务：本分支只产出 APK（不再有 Windows 构建链）
ANDROID_RELEASE_TASKS=":app:assembleRelease"

# 容器模式需要绑定挂载的宿主机目录（空格分隔）
MOUNT_DIRS=""
