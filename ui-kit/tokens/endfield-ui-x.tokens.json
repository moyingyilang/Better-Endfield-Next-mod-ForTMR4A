  "typography": {
    "fontFamily": {
      "sans": ["HarmonyOS Sans SC", "Noto Sans SC", "Source Han Sans SC", "sans-serif"],
      "display": ["Archivo", "Montserrat", "HarmonyOS Sans SC", "sans-serif-medium"],
      "latin": ["Outfit", "Urbanist", "sans-serif"],
      "tech": ["Space Grotesk", "monospace"],
      "mono": ["JetBrains Mono", "Cascadia Code", "monospace"]
    },
    "sizeSp": {
      "micro": 10,
      "xs": 12,
      "sm": 14,
      "base": 16,
      "lg": 20,
      "xl": 24,
      "xxl": 32,
      "xxxl": 40,
      "title": 52,
      "hero": 72,
      "ghostMin": 80,
      "ghostMax": 200
    },
    "lineHeightMultiplier": {
      "micro": 1.0,
      "xs": 1.25,
      "sm": 1.4,
      "base": 1.6,
      "lg": 1.2,
      "xl": 1.1,
      "xxlAndUp": 1.0
    },
    "letterSpacingEm": {
      "label": 0.05,
      "ghost": -0.04
    }
  },
  "spacingDp": [4, 8, 12, 16, 24, 32, 48, 64, 96],
  "radiusDp": {
    "none": 0,
    "xs": 2,
    "sm": 4,
    "md": 6,
    "full": 9999
  },
  "cutDp": {
    "sm": 6,
    "md": 10,
    "lg": 16
  },
  "strokeDp": {
    "hairline": 1,
    "strong": 1
  },
  "shadowDp": {
    "xs": "0 0 4 rgba(0,0,0,0.25)",
    "sm": "0 0 8 rgba(0,0,0,0.25)",
    "md": "0 0 12 rgba(0,0,0,0.30)",
    "lg": "0 0 24 rgba(0,0,0,0.30)"
  },
  "motionMs": {
    "instant": 50,
    "fast": 200,
    "base": 300,
    "slow": 400,
    "slower": 600
  },
  "easing": {
    "standard": "ease",
    "emphasis": "ease-in-out",
    "exit": "ease-out"
  },
  "motif": {
    "cornerBracketDp": [8, 12, 16],
    "hatchPeriodDp": 6,
    "registrationStripDp": 3,
    "tickStepDeg": 15
  },
  "android": {
    "minTouchTargetDp": 44,
    "panelGutterDp": 16,
    "panelGutterCompactDp": 8,
    "overlayDefaultTheme": "dark"
  }
}
